             placeholder="Suche, z.B. Weltreise, arbeitslos, Unfall" autocomplete="off">
      <p class="topic-search__status" role="status" aria-live="polite"></p>
    </div>

    <div class="grid topic-grid">
      {% for article in collections.wissen %}
      <a class="card topic-card" href="{{ article.url }}" data-fade
         data-search="{{ article.data.heading or article.data.title }} {{ article.data.description }} {{ article.data.keywords | join(' ') }}">
        <h3>{{ article.data.heading or article.data.title }}</h3>
        <p>{{ article.data.description }}</p>
        <span class="topic-card__more">Mehr erfahren &rarr;</span>
      </a>
      {% endfor %}
    </div>

    <p class="topic-search__empty" hidden>
      Zu dieser Suche gibt es noch keinen Beitrag. <a href="/kontakt/">Frag mich direkt</a>, ich helfe Dir gerne weiter.
    </p>
  </div>
</section>

<section class="alt">
  <div class="container">
